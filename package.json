{
  "name": "dataspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "DataSpace by UbiquitousGuide \u2014 a browser-side multiview visual analytics workspace for multidimensional CSV datasets.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
